# Copy to .env, chmod 600, then fill in real values. Never commit .env.
#
# These are full RTSP URLs, credentials included. They exist only in your local
# .env; nothing in this repository, and nothing the dashboard can read, contains
# them.
#
# Write the password RAW - do not pre-encode it. Frigate 0.18 runs
# escape_special_characters, so it URL-encodes the password component itself.
# A password of @40 becomes %2540 after a second encoding and the camera
# answers 401.
#
# A raw # inside the value must be quoted, or .env treats the rest of the line
# as a comment: FRIGATE_CAMERA_1_RTSP_URL="rtsp://user:pa#ss@CAMERA_IP:554/path"
#
# Encoding is only needed for URLs you open by hand - VLC, ffprobe, curl. Those
# get no second encoder, so encode there: @ -> %40, : -> %3A, / -> %2F,
# # -> %23, ? -> %3F
#
# One line per camera. Four lines naming one host are four cameras only if each
# names a different channel: channels 1-4 on one recorder are four distinct
# feeds. Four byte-identical URLs are one feed copied four times.
# Set enabled: false in config/config.yml for any camera you have not filled in.
FRIGATE_CAMERA_1_RTSP_URL=rtsp://USERNAME:PASSWORD@CAMERA_IP:554/CHANNEL_1_PATH
FRIGATE_CAMERA_2_RTSP_URL=rtsp://USERNAME:PASSWORD@CAMERA_IP:554/CHANNEL_2_PATH
FRIGATE_CAMERA_3_RTSP_URL=rtsp://USERNAME:PASSWORD@CAMERA_IP:554/CHANNEL_3_PATH
FRIGATE_CAMERA_4_RTSP_URL=rtsp://USERNAME:PASSWORD@CAMERA_IP:554/CHANNEL_4_PATH

# ---------------------------------------------------------------------------
# Main streams. Same four cameras, the high quality channel, for the dashboard's
# live view. Detection does NOT use these.
#
# Write the password URL-ENCODED here - the opposite of the four lines above.
#
# Frigate runs escape_special_characters over the detection URL, so a password
# that is already encoded there gets encoded twice: @ becomes %40 and then
# %2540, and the camera answers 401. go2rtc is the other way round: it only
# substitutes this value into its RTSP source and applies no encoder of its own,
# so a RAW password containing @ # / : or ? truncates or misparses the URL it
# builds. Encode it yourself, here: @ -> %40, : -> %3A, / -> %2F, # -> %23,
# ? -> %3F. A literal % is %25.
#
# Quote the value if it contains a # or spaces, or .env will treat the rest of
# the line as a comment.
#
# These values are read by go2rtc, which runs inside the Frigate container, so
# the file itself is handed to that container as its environment. They reach no
# browser and no dashboard endpoint: the proxy serves four fixed WebSocket paths
# and never forwards the URL.
# ---------------------------------------------------------------------------
FRIGATE_CAMERA_1_MAIN_RTSP_URL=rtsp://USERNAME:PASSWORD_URL_ENCODED@CAMERA_IP:554/MAIN_CHANNEL_1_PATH
FRIGATE_CAMERA_2_MAIN_RTSP_URL=rtsp://USERNAME:PASSWORD_URL_ENCODED@CAMERA_IP:554/MAIN_CHANNEL_2_PATH
FRIGATE_CAMERA_3_MAIN_RTSP_URL=rtsp://USERNAME:PASSWORD_URL_ENCODED@CAMERA_IP:554/MAIN_CHANNEL_3_PATH
FRIGATE_CAMERA_4_MAIN_RTSP_URL=rtsp://USERNAME:PASSWORD_URL_ENCODED@CAMERA_IP:554/MAIN_CHANNEL_4_PATH
