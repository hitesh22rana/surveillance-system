# Local secrets - only .env.example is tracked
.env
!.env.example

# Runtime config - only config.example.yml is tracked
config/*
!config/config.example.yml

# Media, logs, and runtime artifacts
storage/
media/
logs/
*.log
captures/
*.mp4
*.jpg
__pycache__/

# The fighting worker's model weights and the environment they are built in.
# Root provisions .models/fighting from outside this repository; the weights are
# hundreds of megabytes, the environment is machine specific, and neither is ever
# something a commit should carry.
.models/
.venv-fighting/
